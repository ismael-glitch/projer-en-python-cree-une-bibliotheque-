-- Base de données simple pour gérer des clients, produits et commandes.
PRAGMA foreign_keys = ON;

CREATE TABLE IF NOT EXISTS clients (
	id INTEGER PRIMARY KEY,
	nom TEXT NOT NULL,
	email TEXT NOT NULL UNIQUE,
	telephone TEXT,
	cree_le TEXT NOT NULL DEFAULT CURRENT_TIMESTAMP
);

CREATE TABLE IF NOT EXISTS produits (
	id INTEGER PRIMARY KEY,
	nom TEXT NOT NULL,
	description TEXT,
	prix REAL NOT NULL CHECK (prix >= 0),
	stock INTEGER NOT NULL DEFAULT 0 CHECK (stock >= 0)
);

CREATE TABLE IF NOT EXISTS commandes (
	id INTEGER PRIMARY KEY,
	client_id INTEGER NOT NULL,
	date_commande TEXT NOT NULL DEFAULT CURRENT_TIMESTAMP,
	statut TEXT NOT NULL DEFAULT 'en attente'
		CHECK (statut IN ('en attente', 'payée', 'expédiée', 'annulée')),
	FOREIGN KEY (client_id) REFERENCES clients(id) ON DELETE RESTRICT
);

CREATE TABLE IF NOT EXISTS lignes_commande (
	commande_id INTEGER NOT NULL,
	produit_id INTEGER NOT NULL,
	quantite INTEGER NOT NULL CHECK (quantite > 0),
	prix_unitaire REAL NOT NULL CHECK (prix_unitaire >= 0),
	PRIMARY KEY (commande_id, produit_id),
	FOREIGN KEY (commande_id) REFERENCES commandes(id) ON DELETE CASCADE,
	FOREIGN KEY (produit_id) REFERENCES produits(id) ON DELETE RESTRICT
);

CREATE INDEX IF NOT EXISTS idx_commandes_client ON commandes(client_id);
CREATE INDEX IF NOT EXISTS idx_lignes_produit ON lignes_commande(produit_id);
